+type stalledPortMapper struct {
+	started chan struct{}
+	release chan struct{}
+}
+
+func (p *stalledPortMapper) Probe(context.Context) (portmappertype.ProbeResult, error) {
+	close(p.started)
+	<-p.release // Simulate a PS5 network operation that ignores cancellation.
+	return portmappertype.ProbeResult{UPnP: true}, nil
+}
+func (*stalledPortMapper) HaveMapping() bool                                          { return false }
+func (*stalledPortMapper) SetGatewayLookupFunc(func() (netip.Addr, netip.Addr, bool)) {}
+func (*stalledPortMapper) NoteNetworkDown()                                           {}
+func (*stalledPortMapper) GetCachedMappingOrStartCreatingOne() (netip.AddrPort, bool) {
+	return netip.AddrPort{}, false
+}
+func (*stalledPortMapper) SetLocalPort(uint16) {}
+func (*stalledPortMapper) Close() error        { return nil }
+
+func TestPS5NetcheckPortMapDeadline(t *testing.T) {
+	stunAddr, cleanup := stuntest.Serve(t)
+	defer cleanup()
+	baseCtx, stop := context.WithCancel(context.Background())
+	defer stop()
+	c := newTestClient(t)
+	pm := &stalledPortMapper{started: make(chan struct{}), release: make(chan struct{})}
+	defer close(pm.release)
+	c.PortMapper = pm
+	if err := c.Standalone(baseCtx, "127.0.0.1:0"); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(baseCtx, 150*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.GetReport(ctx, stuntest.DERPMapOf(stunAddr.String()), nil)
+		done <- err
+	}()
+	select {
+	case <-pm.started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("portmap probe did not start")
+	}
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("GetReport: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("GetReport waited for a stalled portmap probe after its deadline")
+	}
+}
+
+func TestPS5NetcheckCaptivePortalDeadline(t *testing.T) {
+	if !buildfeatures.HasCaptivePortal {
+		t.Skip("captive portal feature not linked")
+	}
+	stunAddr, cleanup := stuntest.Serve(t)
+	defer cleanup()
+	baseCtx, stop := context.WithCancel(context.Background())
+	defer stop()
+	c := newTestClient(t)
+	if err := c.Standalone(baseCtx, "127.0.0.1:0"); err != nil {
+		t.Fatal(err)
+	}
+	portalDone := make(chan struct{})
+	defer close(portalDone)
+	restore := hookStartCaptivePortalDetection.SetForTest(func(context.Context, *reportState, *tailcfg.DERPMap, int) (<-chan struct{}, func()) {
+		return portalDone, func() {}
+	})
+	defer restore()
+	ctx, cancel := context.WithTimeout(baseCtx, 150*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := c.GetReport(ctx, stuntest.DERPMapOf(stunAddr.String()), nil)
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("GetReport: %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("GetReport waited for a stalled captive portal check after its deadline")
+	}
+}
