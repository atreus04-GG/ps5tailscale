diff --git a/control/controlhttp/ps5_blocking_conn_freebsd.go b/control/controlhttp/ps5_blocking_conn_freebsd.go
new file mode 100644
index 0000000..a866831
--- /dev/null
+++ b/control/controlhttp/ps5_blocking_conn_freebsd.go
@@ -0,0 +1,255 @@
+//go:build freebsd
+
+package controlhttp
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// ps5BlockingConn deliberately owns a raw socket that is never handed to
+// net.FileConn or internal/poll, so Go's kqueue netpoller never registers it.
+type ps5BlockingConn struct {
+	fd            int
+	laddr         net.Addr
+	raddr         net.Addr
+	logf          func(string, ...any)
+	close         sync.Once
+	deadlineMu    sync.Mutex
+	readDeadline  time.Time
+	writeDeadline time.Time
+	readYieldSeq  atomic.Uint32
+	writeYieldSeq atomic.Uint32
+}
+
+func auth174Backoff() {
+	req := unix.Timespec{Nsec: int64(time.Millisecond)}
+	var rem unix.Timespec
+	for {
+		err := unix.Nanosleep(&req, &rem)
+		if err != unix.EINTR {
+			return
+		}
+		req = rem
+	}
+}
+
+func ps5BlockingDialContext(ctx context.Context, network, address string, logf func(string, ...any)) (net.Conn, error) {
+	if network != "tcp4" && network != "tcp" {
+		return nil, fmt.Errorf("AUTH154 blocking dial only supports tcp4, got %q", network)
+	}
+	host, portText, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	ip := net.ParseIP(host).To4()
+	if ip == nil {
+		return nil, fmt.Errorf("AUTH154 blocking dial requires IPv4 literal: %q", host)
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port < 1 || port > 65535 {
+		return nil, fmt.Errorf("AUTH154 invalid port %q", portText)
+	}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	default:
+	}
+
+	fd, err := unix.Socket(unix.AF_INET, unix.SOCK_STREAM, 0)
+	if err != nil {
+		return nil, err
+	}
+	unix.CloseOnExec(fd)
+	logf("[AUTH163 control] socket-after fd=%d err=<nil>", fd)
+	sa := &unix.SockaddrInet4{Port: port}
+	copy(sa.Addr[:], ip)
+	if err := unix.SetNonblock(fd, true); err != nil {
+		unix.Close(fd)
+		return nil, err
+	}
+	logf("[AUTH163 control] connect-before fd=%d address=%s", fd, address)
+	err = unix.Connect(fd, sa)
+	logf("[AUTH163 control] connect-after fd=%d err=%v", fd, err)
+	if err != nil && err != unix.EINPROGRESS && err != unix.EALREADY && err != unix.EINTR && err != unix.EISCONN {
+		unix.Close(fd)
+		return nil, err
+	}
+	if err != nil && err != unix.EISCONN {
+		pollfd := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLOUT}}
+		for {
+			if err := ctx.Err(); err != nil {
+				unix.Close(fd)
+				return nil, err
+			}
+			timeoutMS := 100
+			if deadline, ok := ctx.Deadline(); ok {
+				remaining := time.Until(deadline)
+				if remaining <= 0 {
+					unix.Close(fd)
+					return nil, context.DeadlineExceeded
+				}
+				remainingMS := int((remaining + time.Millisecond - 1) / time.Millisecond)
+				if remainingMS < timeoutMS {
+					timeoutMS = remainingMS
+				}
+			}
+			pollfd[0].Revents = 0
+			logf("[AUTH163 control] poll-before fd=%d timeout_ms=%d", fd, timeoutMS)
+			n, pollErr := unix.Poll(pollfd, timeoutMS)
+			logf("[AUTH163 control] poll-after fd=%d n=%d revents=%d err=%v", fd, n, pollfd[0].Revents, pollErr)
+			if pollErr == unix.EINTR {
+				continue
+			}
+			if pollErr != nil {
+				unix.Close(fd)
+				return nil, pollErr
+			}
+			if n == 0 {
+				continue
+			}
+			soErr, getsockoptErr := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_ERROR)
+			logf("[AUTH163 control] so-error fd=%d value=%d err=%v", fd, soErr, getsockoptErr)
+			if getsockoptErr != nil {
+				unix.Close(fd)
+				return nil, getsockoptErr
+			}
+			if soErr != 0 {
+				unix.Close(fd)
+				return nil, unix.Errno(soErr)
+			}
+			break
+		}
+	}
+	logf("[AUTH165 control] connected-nonblocking fd=%d", fd)
+
+	remote := &net.TCPAddr{IP: append(net.IP(nil), ip...), Port: port}
+	local := net.Addr(&net.TCPAddr{})
+	if lsa, err := unix.Getsockname(fd); err == nil {
+		if a, ok := lsa.(*unix.SockaddrInet4); ok {
+			local = &net.TCPAddr{IP: net.IPv4(a.Addr[0], a.Addr[1], a.Addr[2], a.Addr[3]), Port: a.Port}
+		}
+	}
+	return &ps5BlockingConn{fd: fd, laddr: local, raddr: remote, logf: logf}, nil
+}
+
+func (c *ps5BlockingConn) Read(p []byte) (int, error) {
+	for {
+		n, err := unix.Read(c.fd, p)
+		if n > 0 {
+			return n, err
+		}
+		if err == nil {
+			return 0, io.EOF
+		}
+		if err == unix.EINTR {
+			continue
+		}
+		if err != unix.EAGAIN && err != unix.EWOULDBLOCK {
+			return 0, err
+		}
+		_, expired := c.pollTimeout(true)
+		if expired {
+			return 0, unix.EAGAIN
+		}
+		seq := c.readYieldSeq.Add(1)
+		trace := seq <= 16
+		if trace {
+			c.logf("[AUTH174 control] read-backoff-before fd=%d seq=%d", c.fd, seq)
+		}
+		auth174Backoff()
+		if trace {
+			c.logf("[AUTH174 control] read-backoff-after fd=%d seq=%d", c.fd, seq)
+		}
+	}
+}
+
+func (c *ps5BlockingConn) Write(p []byte) (int, error) {
+	for {
+		n, err := unix.Write(c.fd, p)
+		if n > 0 {
+			return n, err
+		}
+		if err == nil {
+			return 0, nil
+		}
+		if err == unix.EINTR {
+			continue
+		}
+		if err != unix.EAGAIN && err != unix.EWOULDBLOCK {
+			return 0, err
+		}
+		_, expired := c.pollTimeout(false)
+		if expired {
+			return 0, unix.EAGAIN
+		}
+		seq := c.writeYieldSeq.Add(1)
+		trace := seq <= 16
+		if trace {
+			c.logf("[AUTH174 control] write-backoff-before fd=%d seq=%d", c.fd, seq)
+		}
+		auth174Backoff()
+		if trace {
+			c.logf("[AUTH174 control] write-backoff-after fd=%d seq=%d", c.fd, seq)
+		}
+	}
+}
+
+func (c *ps5BlockingConn) Close() error {
+	var err error
+	c.close.Do(func() { err = unix.Close(c.fd) })
+	return err
+}
+
+func (c *ps5BlockingConn) LocalAddr() net.Addr  { return c.laddr }
+func (c *ps5BlockingConn) RemoteAddr() net.Addr { return c.raddr }
+
+func (c *ps5BlockingConn) SetDeadline(t time.Time) error {
+	if err := c.SetReadDeadline(t); err != nil {
+		return err
+	}
+	return c.SetWriteDeadline(t)
+}
+
+func (c *ps5BlockingConn) pollTimeout(read bool) (timeoutMS int, expired bool) {
+	c.deadlineMu.Lock()
+	deadline := c.writeDeadline
+	if read {
+		deadline = c.readDeadline
+	}
+	c.deadlineMu.Unlock()
+	if deadline.IsZero() {
+		return 100, false
+	}
+	remaining := time.Until(deadline)
+	if remaining <= 0 {
+		return 0, true
+	}
+	remainingMS := int((remaining + time.Millisecond - 1) / time.Millisecond)
+	if remainingMS > 100 {
+		remainingMS = 100
+	}
+	return remainingMS, false
+}
+
+func (c *ps5BlockingConn) SetReadDeadline(t time.Time) error {
+	c.deadlineMu.Lock()
+	c.readDeadline = t
+	c.deadlineMu.Unlock()
+	return nil
+}
+
+func (c *ps5BlockingConn) SetWriteDeadline(t time.Time) error {
+	c.deadlineMu.Lock()
+	c.writeDeadline = t
+	c.deadlineMu.Unlock()
+	return nil
+}
