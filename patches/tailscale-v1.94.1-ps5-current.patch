@@ -0,0 +1,35 @@
+package ts2021
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestPS5HTTP2FrameTraceFragmented(t *testing.T) {
+	var logs []string
+	c := &Conn{
+		logf: func(format string, args ...any) {
+			logs = append(logs, fmt.Sprintf(format, args...))
+		},
+		h2TraceOut: h2FrameTraceState{prefaceRemaining: len("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")},
+	}
+	wire := append([]byte("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"),
+		0, 0, 3, 1, 4, 0, 0, 0, 1, 'a', 'b', 'c',
+		0, 0, 0, 0, 1, 0, 0, 0, 1)
+
+	c.traceHTTP2Frames("OUT", &c.h2TraceOut, wire[:27])
+	c.traceHTTP2Frames("OUT", &c.h2TraceOut, wire[27:35])
+	c.traceHTTP2Frames("OUT", &c.h2TraceOut, wire[35:])
+
+	got := strings.Join(logs, "\n")
+	for _, want := range []string{
+		"[PS5 h2] OUT client preface complete",
+		"frame=HEADERS type=1 flags=0x04 stream=1 length=3",
+		"frame=DATA type=0 flags=0x01 stream=1 length=0",
+	} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("trace missing %q; got:\n%s", want, got)
+		}
+	}
+}
