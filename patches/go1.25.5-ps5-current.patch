diff --git a/src/internal/poll/ps5_trace.go b/src/internal/poll/ps5_trace.go
new file mode 100644
index 0000000..e3ad1f8
--- /dev/null
+++ b/src/internal/poll/ps5_trace.go
@@ -0,0 +1,47 @@
+//go:build unix
+
+package poll
+
+import (
+	"strconv"
+	"sync/atomic"
+	"syscall"
+)
+
+var ps5PollTraceFD atomic.Int64
+
+func init() {
+	ps5PollTraceFD.Store(-1)
+}
+
+func runtime_setPS5PollTraceFD(fd int)
+
+func SetPS5PollTraceFDForTest(fd int) {
+	ps5PollTraceFD.Store(int64(fd))
+	runtime_setPS5PollTraceFD(fd)
+}
+
+func PS5TraceForTest(stage string, fd int, detail int64) {
+	ps5PollTrace(stage, fd, detail, nil)
+}
+
+func ps5PollTrace(stage string, fd int, detail int64, err error) {
+	outfd := int(ps5PollTraceFD.Load())
+	if outfd < 0 {
+		return
+	}
+	b := make([]byte, 0, 160)
+	b = append(b, "[AUTH151 poll-direct] stage="...)
+	b = append(b, stage...)
+	b = append(b, " fd="...)
+	b = strconv.AppendInt(b, int64(fd), 10)
+	b = append(b, " detail="...)
+	b = strconv.AppendInt(b, detail, 10)
+	if err != nil {
+		b = append(b, " err=1"...)
+	} else {
+		b = append(b, " err=0"...)
+	}
+	b = append(b, '\n')
+	_, _ = syscall.Write(outfd, b)
+}
