diff --git a/src/net/ps5_blocking_tcp_freebsd.go b/src/net/ps5_blocking_tcp_freebsd.go
new file mode 100644
index 0000000..2b03bfb
--- /dev/null
+++ b/src/net/ps5_blocking_tcp_freebsd.go
@@ -0,0 +1,160 @@
+//go:build freebsd
+
+package net
+
+import (
+	"context"
+	"internal/poll"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type ps5BlockingTCPConn struct {
+	fd    int
+	laddr Addr
+	raddr Addr
+	once  sync.Once
+}
+
+func ps5RawTCPDial(ctx context.Context, network string, la, ra *TCPAddr) (Conn, bool, error) {
+	if ra == nil {
+		return nil, false, nil
+	}
+	family := syscall.AF_INET6
+	var rsa syscall.Sockaddr
+	if ip4 := ra.IP.To4(); ip4 != nil {
+		family = syscall.AF_INET
+		sa := &syscall.SockaddrInet4{Port: ra.Port}
+		copy(sa.Addr[:], ip4)
+		rsa = sa
+	} else {
+		ip16 := ra.IP.To16()
+		if ip16 == nil || ra.Zone != "" {
+			return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: syscall.EAFNOSUPPORT}
+		}
+		sa := &syscall.SockaddrInet6{Port: ra.Port}
+		copy(sa.Addr[:], ip16)
+		rsa = sa
+	}
+
+	select {
+	case <-ctx.Done():
+		return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: mapErr(ctx.Err())}
+	default:
+	}
+
+	fd, err := syscall.Socket(family, syscall.SOCK_STREAM, syscall.IPPROTO_TCP)
+	if err != nil {
+		return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: err}
+	}
+	syscall.CloseOnExec(fd)
+	poll.PS5TraceForTest("AUTH157-raw-tcp-socket", fd, int64(uint64(uint32(family))<<32|uint64(uint32(syscall.SOCK_STREAM))))
+
+	if la != nil {
+		var lsa syscall.Sockaddr
+		if family == syscall.AF_INET {
+			ip4 := la.IP.To4()
+			if ip4 == nil {
+				syscall.Close(fd)
+				return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: syscall.EAFNOSUPPORT}
+			}
+			sa := &syscall.SockaddrInet4{Port: la.Port}
+			copy(sa.Addr[:], ip4)
+			lsa = sa
+		} else {
+			ip16 := la.IP.To16()
+			if ip16 == nil || la.Zone != "" {
+				syscall.Close(fd)
+				return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: syscall.EAFNOSUPPORT}
+			}
+			sa := &syscall.SockaddrInet6{Port: la.Port}
+			copy(sa.Addr[:], ip16)
+			lsa = sa
+		}
+		if err := syscall.Bind(fd, lsa); err != nil {
+			syscall.Close(fd)
+			return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: err}
+		}
+	}
+
+	if deadline, ok := ctx.Deadline(); ok {
+		tv := ps5BlockingTimeval(deadline)
+		_ = syscall.SetsockoptTimeval(fd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &tv)
+	}
+	poll.PS5TraceForTest("AUTH157-raw-tcp-connect-before", fd, int64(family))
+	if err := syscall.Connect(fd, rsa); err != nil {
+		poll.PS5TraceForTest("AUTH157-raw-tcp-connect-error", fd, 1)
+		syscall.Close(fd)
+		return nil, true, &OpError{Op: "dial", Net: network, Source: la, Addr: ra, Err: err}
+	}
+	poll.PS5TraceForTest("AUTH157-raw-tcp-connect-after", fd, int64(family))
+	_ = syscall.SetsockoptTimeval(fd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &syscall.Timeval{})
+
+	laddr := Addr(&TCPAddr{})
+	if sa, err := syscall.Getsockname(fd); err == nil {
+		switch a := sa.(type) {
+		case *syscall.SockaddrInet4:
+			laddr = &TCPAddr{IP: IPv4(a.Addr[0], a.Addr[1], a.Addr[2], a.Addr[3]), Port: a.Port}
+		case *syscall.SockaddrInet6:
+			ip := make(IP, IPv6len)
+			copy(ip, a.Addr[:])
+			laddr = &TCPAddr{IP: ip, Port: a.Port}
+		}
+	}
+	return &ps5BlockingTCPConn{fd: fd, laddr: laddr, raddr: ra}, true, nil
+}
+
+func ps5BlockingTimeval(t time.Time) syscall.Timeval {
+	if t.IsZero() {
+		return syscall.Timeval{}
+	}
+	d := time.Until(t)
+	if d <= 0 {
+		d = time.Microsecond
+	}
+	return syscall.NsecToTimeval(d.Nanoseconds())
+}
+
+func ps5SetNativeDeadline(fd uintptr, sotype int, t time.Time, read, write bool) (bool, error) {
+	if sotype != syscall.SOCK_DGRAM {
+		return false, nil
+	}
+	sysfd := int(fd)
+	tv := ps5BlockingTimeval(t)
+	if read {
+		if err := syscall.SetsockoptTimeval(sysfd, syscall.SOL_SOCKET, syscall.SO_RCVTIMEO, &tv); err != nil {
+			return true, err
+		}
+	}
+	if write {
+		if err := syscall.SetsockoptTimeval(sysfd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &tv); err != nil {
+			return true, err
+		}
+	}
+	return true, nil
+}
+
+func (c *ps5BlockingTCPConn) Read(p []byte) (int, error)  { return syscall.Read(c.fd, p) }
+func (c *ps5BlockingTCPConn) Write(p []byte) (int, error) { return syscall.Write(c.fd, p) }
+func (c *ps5BlockingTCPConn) Close() error {
+	var err error
+	c.once.Do(func() { err = syscall.Close(c.fd) })
+	return err
+}
+func (c *ps5BlockingTCPConn) LocalAddr() Addr  { return c.laddr }
+func (c *ps5BlockingTCPConn) RemoteAddr() Addr { return c.raddr }
+func (c *ps5BlockingTCPConn) SetDeadline(t time.Time) error {
+	if err := c.SetReadDeadline(t); err != nil {
+		return err
+	}
+	return c.SetWriteDeadline(t)
+}
+func (c *ps5BlockingTCPConn) SetReadDeadline(t time.Time) error {
+	tv := ps5BlockingTimeval(t)
+	return syscall.SetsockoptTimeval(c.fd, syscall.SOL_SOCKET, syscall.SO_RCVTIMEO, &tv)
+}
+func (c *ps5BlockingTCPConn) SetWriteDeadline(t time.Time) error {
+	tv := ps5BlockingTimeval(t)
+	return syscall.SetsockoptTimeval(c.fd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &tv)
+}
