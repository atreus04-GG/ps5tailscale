new file mode 100644
index 0000000..673dbb0
--- /dev/null
+++ b/src/runtime/ps5_netpoll_trace.go
@@ -0,0 +1,116 @@
+//go:build darwin || dragonfly || freebsd || netbsd || openbsd
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+var ps5RuntimeTraceFD atomic.Int32
+
+func init() {
+	ps5RuntimeTraceFD.Store(-1)
+}
+
+//go:linkname runtime_setPS5PollTraceFD internal/poll.runtime_setPS5PollTraceFD
+func runtime_setPS5PollTraceFD(fd int) {
+	ps5RuntimeTraceFD.Store(int32(fd))
+}
+
+//go:nosplit
+func ps5rtAppendString(b *[192]byte, n int, s string) int {
+	for i := 0; i < len(s) && n < len(b); i++ {
+		b[n] = s[i]
+		n++
+	}
+	return n
+}
+
+//go:nosplit
+func ps5rtAppendInt(b *[192]byte, n int, v int64) int {
+	if v < 0 {
+		if n < len(b) {
+			b[n] = '-'
+			n++
+		}
+		v = -v
+	}
+	var tmp [24]byte
+	i := len(tmp)
+	if v == 0 {
+		i--
+		tmp[i] = '0'
+	} else {
+		for v > 0 && i > 0 {
+			i--
+			tmp[i] = byte('0' + v%10)
+			v /= 10
+		}
+	}
+	for ; i < len(tmp) && n < len(b); i++ {
+		b[n] = tmp[i]
+		n++
+	}
+	return n
+}
+
+//go:nosplit
+func ps5RuntimeTrace(event string, a, bval int64) {
+	if GOOS != "freebsd" {
+		return
+	}
+	fd := ps5RuntimeTraceFD.Load()
+	if fd < 0 {
+		return
+	}
+	var buf [192]byte
+	n := 0
+	n = ps5rtAppendString(&buf, n, "[AUTH152 runtime] event=")
+	n = ps5rtAppendString(&buf, n, event)
+	n = ps5rtAppendString(&buf, n, " a=")
+	n = ps5rtAppendInt(&buf, n, a)
+	n = ps5rtAppendString(&buf, n, " b=")
+	n = ps5rtAppendInt(&buf, n, bval)
+	if n < len(buf) {
+		buf[n] = '\n'
+		n++
+	}
+	if n > 0 {
+		write1(uintptr(fd), unsafe.Pointer(&buf[0]), int32(n))
+	}
+}
+
+// ps5RuntimeSignalSendTrace records every signal-producing syscall made through
+// the Go runtime or the public syscall entry points. It intentionally uses the
+// already-open direct UDP descriptor and runtime.write1 so it neither allocates
+// nor enters the ordinary Go network stack.
+//
+//go:nosplit
+//go:linkname ps5RuntimeSignalSendTrace runtime.ps5RuntimeSignalSendTrace
+func ps5RuntimeSignalSendTrace(trap, a1, a2, a3 int64) {
+	if GOOS != "freebsd" {
+		return
+	}
+	fd := ps5RuntimeTraceFD.Load()
+	if fd < 0 {
+		return
+	}
+	var buf [192]byte
+	n := 0
+	n = ps5rtAppendString(&buf, n, "[AUTH186 runtime] event=SIGNAL-SEND trap=")
+	n = ps5rtAppendInt(&buf, n, trap)
+	n = ps5rtAppendString(&buf, n, " a1=")
+	n = ps5rtAppendInt(&buf, n, a1)
+	n = ps5rtAppendString(&buf, n, " a2=")
+	n = ps5rtAppendInt(&buf, n, a2)
+	n = ps5rtAppendString(&buf, n, " a3=")
+	n = ps5rtAppendInt(&buf, n, a3)
+	if n < len(buf) {
+		buf[n] = '\n'
+		n++
+	}
+	if n > 0 {
+		write1(uintptr(fd), unsafe.Pointer(&buf[0]), int32(n))
+	}
+}
