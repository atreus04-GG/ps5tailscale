+package main
+
+/*
+#include "errno.h"
+void tsp5_go_lib_stage(int stage);
+*/
+import "C"
+
+import (
+	"io"
+	"net"
+	"time"
+)
+
+//export TsnetPS5DelayedTCPServerProbe
+func TsnetPS5DelayedTCPServerProbe(timeoutMS C.int) C.int {
+	timeout := time.Duration(int(timeoutMS)) * time.Millisecond
+	C.tsp5_go_lib_stage(201)
+
+	ln, err := net.Listen("tcp", "0.0.0.0:19001")
+	if err != nil {
+		C.tsp5_go_lib_stage(291)
+		return -1
+	}
+	defer ln.Close()
+
+	C.tsp5_go_lib_stage(202)
+	if tl, ok := ln.(*net.TCPListener); ok {
+		_ = tl.SetDeadline(time.Now().Add(timeout))
+	}
+
+	conn, err := ln.Accept()
+	if err != nil {
+		C.tsp5_go_lib_stage(292)
+		return -2
+	}
+	defer conn.Close()
+
+	C.tsp5_go_lib_stage(203)
+	_ = conn.SetDeadline(time.Now().Add(timeout))
+
+	buf := make([]byte, 4)
+	C.tsp5_go_lib_stage(204)
+	if _, err := io.ReadFull(conn, buf); err != nil {
+		C.tsp5_go_lib_stage(293)
+		return -3
+	}
+
+	C.tsp5_go_lib_stage(205)
+	if string(buf) != "WAKE" {
+		C.tsp5_go_lib_stage(294)
+		return -4
+	}
+
+	C.tsp5_go_lib_stage(206)
+	return 0
+}
+
+//export TsnetPS5DelayedTCPClientProbe
+func TsnetPS5DelayedTCPClientProbe(addr *C.char, timeoutMS C.int) C.int {
+	target := C.GoString(addr)
+	timeout := time.Duration(int(timeoutMS)) * time.Millisecond
+	C.tsp5_go_lib_stage(211)
+
+	dialer := net.Dialer{Timeout: timeout}
+	conn, err := dialer.Dial("tcp6", target)
+	if err != nil {
+		C.tsp5_go_lib_stage(295)
+		return -1
+	}
+	defer conn.Close()
+
+	C.tsp5_go_lib_stage(212)
+	_ = conn.SetDeadline(time.Now().Add(timeout))
+
+	buf := make([]byte, 4)
+	C.tsp5_go_lib_stage(213)
+	if _, err := io.ReadFull(conn, buf); err != nil {
+		C.tsp5_go_lib_stage(296)
+		return -2
+	}
+
+	C.tsp5_go_lib_stage(214)
+	if string(buf) != "WAKE" {
+		C.tsp5_go_lib_stage(297)
+		return -3
+	}
+
+	C.tsp5_go_lib_stage(215)
+	return 0
+}
