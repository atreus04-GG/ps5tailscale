@@ -0,0 +1,20 @@
+package main
+
+/*
+void tsp5_go_lib_stage(int stage);
+*/
+import "C"
+
+import "time"
+
+//export TsnetPS5StartTimerHeartbeat
+func TsnetPS5StartTimerHeartbeat() C.int {
+	go func() {
+		C.tsp5_go_lib_stage(311)
+		for i := 0; i < 12; i++ {
+			time.Sleep(5 * time.Second)
+			C.tsp5_go_lib_stage(C.int(312 + i))
+		}
+	}()
+	return 0
+}
