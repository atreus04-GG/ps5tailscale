+//export TsnetPS5StartRemotePlayProxy
+func TsnetPS5StartRemotePlayProxy(sd C.int, targetIPC *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	targetIP := strings.TrimSpace(C.GoString(targetIPC))
+	if net.ParseIP(targetIP) == nil {
+		return s.recErr(fmt.Errorf("invalid Remote Play proxy target IP %q", targetIP))
+	}
+
+	s.remotePlayMu.Lock()
+	defer s.remotePlayMu.Unlock()
+	if s.remotePlayStarted {
+		if s.remotePlayTargetIP == targetIP {
+			s.remotePlayLogf("already started target=%s", targetIP)
+			return 0
+		}
+		return s.recErr(fmt.Errorf("Remote Play proxy already started for %s", s.remotePlayTargetIP))
+	}
+
+	ip4, _ := s.s.TailscaleIPs()
+	if !ip4.IsValid() {
+		return s.recErr(fmt.Errorf("Remote Play proxy has no Tailscale IPv4"))
+	}
+
+	startedTCP := make([]net.Listener, 0, 1)
+	startedUDP := make([]net.PacketConn, 0, 4)
+	for _, spec := range remotePlayProxySpecs {
+		if spec.network == "tcp" {
+			addr := ":" + strconv.Itoa(spec.port)
+			ln, err := s.s.Listen("tcp", addr)
+			if err != nil {
+				for _, prior := range startedTCP {
+					_ = prior.Close()
+				}
+				for _, prior := range startedUDP {
+					_ = prior.Close()
+				}
+				return s.recErr(fmt.Errorf("Remote Play proxy listen tcp %s: %w", addr, err))
+			}
+			startedTCP = append(startedTCP, ln)
+			s.remotePlayLogf("listener ready network=tcp port=%d target=%s", spec.port, targetIP)
+			go s.serveRemotePlayTCPListener(spec.port, ln, targetIP)
+			continue
+		}
+
+		addr := net.JoinHostPort(ip4.String(), strconv.Itoa(spec.port))
+		pc, err := s.s.ListenPacket("udp4", addr)
+		if err != nil {
+			for _, prior := range startedTCP {
+				_ = prior.Close()
+			}
+			for _, prior := range startedUDP {
+				_ = prior.Close()
+			}
+			return s.recErr(fmt.Errorf("Remote Play proxy listen udp4 %s: %w", addr, err))
+		}
+		startedUDP = append(startedUDP, pc)
+		s.remotePlayLogf("packet listener ready network=udp4 port=%d tailnet=%s target=%s", spec.port, ip4, targetIP)
+		go s.serveRemotePlayUDP(spec.port, pc, targetIP)
+	}
+
+	s.remotePlayListeners = startedTCP
+	s.remotePlayPacketConns = startedUDP
+	s.remotePlayTargetIP = targetIP
+	s.remotePlayStarted = true
+	s.remotePlayLogf("ready target=%s tcp=9295 udp-packet=9295,9296,9297,9302", targetIP)
+	return 0
+}
