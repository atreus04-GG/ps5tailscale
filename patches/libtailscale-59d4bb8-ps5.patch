+func (s *server) relayRemotePlayUDPReplies(port int, tailPC net.PacketConn, flow *remotePlayUDPFlow, stats *remotePlayUDPStats) {
+	buf := make([]byte, 65535)
+	for {
+		n, err := flow.backend.Read(buf)
+		if err != nil {
+			return
+		}
+		stats.ps5RxPackets.Add(1)
+		stats.ps5RxBytes.Add(uint64(n))
+		if _, err := tailPC.WriteTo(buf[:n], flow.client); err != nil {
+			stats.dropped.Add(1)
+			continue
+		}
+		stats.clientTxPackets.Add(1)
+		stats.clientTxBytes.Add(uint64(n))
+	}
+}
