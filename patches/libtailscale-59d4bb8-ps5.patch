+func (s *server) serveRemotePlayUDP(port int, tailPC net.PacketConn, targetIP string) {
+	targetAddr, err := net.ResolveUDPAddr("udp4", net.JoinHostPort(targetIP, strconv.Itoa(port)))
+	if err != nil {
+		s.remotePlayLogf("udp target resolve failed port=%d target=%s err=%v", port, targetIP, err)
+		return
+	}
+
+	stats := &remotePlayUDPStats{}
+	go s.runRemotePlayUDPStats(port, stats)
+
+	var mu sync.Mutex
+	flows := map[string]*remotePlayUDPFlow{}
+	buf := make([]byte, 65535)
+
+	for {
+		n, clientAddr, err := tailPC.ReadFrom(buf)
+		if err != nil {
+			s.remotePlayLogf("udp listener stopped port=%d err=%v", port, err)
+			return
+		}
+		stats.clientRxPackets.Add(1)
+		stats.clientRxBytes.Add(uint64(n))
+
+		key := clientAddr.String()
+		now := time.Now()
+
+		mu.Lock()
+		flow := flows[key]
+		if flow != nil && now.Sub(flow.lastUse) > 60*time.Second {
+			_ = flow.backend.Close()
+			delete(flows, key)
+			flow = nil
+		}
+		if flow == nil {
+			backend, dialErr := net.DialUDP("udp4", nil, targetAddr)
+			if dialErr != nil {
+				mu.Unlock()
+				stats.dropped.Add(1)
+				s.remotePlayLogf("udp backend dial failed port=%d client=%s target=%s err=%v", port, key, targetAddr, dialErr)
+				continue
+			}
+			flow = &remotePlayUDPFlow{backend: backend, client: clientAddr, lastUse: now}
+			flows[key] = flow
+			go s.relayRemotePlayUDPReplies(port, tailPC, flow, stats)
+			s.remotePlayLogf("udp flow open port=%d client=%s target=%s", port, key, targetAddr)
+		} else {
+			flow.lastUse = now
+		}
+		backend := flow.backend
+		mu.Unlock()
+
+		if _, err := backend.Write(buf[:n]); err != nil {
+			stats.dropped.Add(1)
+			continue
+		}
+		stats.ps5TxPackets.Add(1)
+	}
+}
